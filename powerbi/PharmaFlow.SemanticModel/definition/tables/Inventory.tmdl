table Inventory
	lineageTag: cf96608c-16d8-50e8-8eb0-d7ab696317e4

	measure 'On Hand Units' =
			SUM ( Inventory[Quantity] )
		formatString: #,0
		displayFolder: Stock
		lineageTag: f33bf19b-37d4-5b93-b311-f4594b843ad9

	measure 'Usable Stock' =
			SUM ( Inventory[Usable Quantity] )
		formatString: #,0
		displayFolder: Stock
		lineageTag: 49a36040-6695-52e4-a5c4-6fda54f7115d

	measure 'Total Stock Value' =
			SUM ( Inventory[Stock Value] )
		formatString: $#,0
		displayFolder: Stock
		lineageTag: cb2703e7-d18d-511e-bbdd-fbd9e5f05704

	measure 'Warehouses In Scope' =
			CALCULATE (
			    DISTINCTCOUNT ( Inventory[Warehouse ID] ),
			    REMOVEFILTERS ( Products[Product] ),
			    REMOVEFILTERS ( Products[Product ID] )
			)
		formatString: 0
		displayFolder: Replenishment
		lineageTag: d13b7459-dc56-5d29-85f3-42e367fa128f

	measure 'Reorder Point' =
			-- Reorder level is set per warehouse, so scale it by the warehouses in scope
			IF (
			    NOT ISBLANK ( [On Hand Units] ),
			    SUMX ( VALUES ( Products[Product ID] ), CALCULATE ( MAX ( Products[Reorder Level] ) ) ) * [Warehouses In Scope]
			)
		formatString: #,0
		displayFolder: Replenishment
		lineageTag: 80ae11cd-de70-5058-a77b-05ef2d521ef3

	measure 'Below Reorder By' =
			-- Expired batches can't be dispensed, so only usable stock counts
			SUMX (
			    VALUES ( Products[Product ID] ),
			    VAR _rp = [Reorder Point]
			    VAR _usable = [Usable Stock] + 0
			    RETURN IF ( NOT ISBLANK ( [On Hand Units] ) && _usable <= _rp, _rp - _usable )
			)
		formatString: #,0
		displayFolder: Replenishment
		lineageTag: 99a83cf4-a551-51d6-95bf-3888138e7e78

	measure 'Stock-out Risk' =
			COUNTROWS (
			    FILTER (
			        VALUES ( Products[Product ID] ),
			        NOT ISBLANK ( [On Hand Units] ) && [Usable Stock] + 0 <= [Reorder Point]
			    )
			) + 0
		formatString: 0
		displayFolder: Replenishment
		lineageTag: 7e45b1bf-f7b0-57aa-9ae7-2ef59a325b78

	measure 'Cost to Restock' =
			SUMX (
			    VALUES ( Products[Product ID] ),
			    VAR _rp = [Reorder Point]
			    VAR _usable = [Usable Stock] + 0
			    RETURN IF ( NOT ISBLANK ( [On Hand Units] ) && _usable <= _rp, ( _rp - _usable ) * CALCULATE ( MAX ( Products[Unit Cost] ) ) )
			) + 0
		formatString: $#,0
		displayFolder: Replenishment
		lineageTag: 25363037-2f95-51cf-aad4-4394d33361a8

	measure 'On Hand (Alert)' =
			IF ( NOT ISBLANK ( [Below Reorder By] ), [On Hand Units] )
		formatString: #,0
		displayFolder: Replenishment
		lineageTag: 88972384-0caa-5282-b49b-6f217d10dd58

	measure 'Usable Stock (Alert)' =
			IF ( NOT ISBLANK ( [Below Reorder By] ), [Usable Stock] + 0 )
		formatString: #,0
		displayFolder: Replenishment
		lineageTag: b5814c2d-8a7b-525b-9c31-e8814a12325c

	measure 'Reorder Point (Alert)' =
			IF ( NOT ISBLANK ( [Below Reorder By] ), [Reorder Point] )
		formatString: #,0
		displayFolder: Replenishment
		lineageTag: bac72207-1649-51e2-94e2-56a449890d47

	measure 'Restock Cost (Alert)' =
			IF ( NOT ISBLANK ( [Below Reorder By] ), [Cost to Restock] )
		formatString: $#,0
		displayFolder: Replenishment
		lineageTag: 7b283d4e-a0f6-58d3-acdf-7340366f0679

	measure 'Batches Expiring 90d' =
			CALCULATE (
			    DISTINCTCOUNT ( Inventory[Batch] ),
			    Inventory[Days To Expiry] >= 0,
			    Inventory[Days To Expiry] <= 90
			) + 0
		formatString: #,0
		displayFolder: Expiry
		lineageTag: e79475ec-7913-579e-80ff-c307eccd881a

	measure 'Value Expiring 90d' =
			CALCULATE (
			    [Total Stock Value],
			    Inventory[Days To Expiry] >= 0,
			    Inventory[Days To Expiry] <= 90
			) + 0
		formatString: $#,0
		displayFolder: Expiry
		lineageTag: e61e71cb-12c3-50b7-ae01-6a1303018936

	measure 'Value Expired' =
			CALCULATE ( [Total Stock Value], Inventory[Days To Expiry] < 0 ) + 0
		formatString: $#,0
		displayFolder: Expiry
		lineageTag: ffe31158-a89d-5419-926c-4c054b6d0167

	measure 'Units At Risk' =
			CALCULATE ( SUM ( Inventory[Quantity] ), Inventory[Days To Expiry] <= 90 )
		formatString: #,0
		displayFolder: Expiry
		lineageTag: d0afd6cc-1eb8-5974-a0af-7ffad2019ab9

	measure 'Batches At Risk' =
			CALCULATE ( DISTINCTCOUNT ( Inventory[Batch] ), Inventory[Days To Expiry] <= 90 )
		formatString: #,0
		displayFolder: Expiry
		lineageTag: 680663b4-ebee-5140-adcd-1b544feb1e09

	measure 'Capacity In Scope' =
			SUMX (
			    FILTER ( VALUES ( Warehouses[Warehouse ID] ), CALCULATE ( NOT ISEMPTY ( Inventory ) ) ),
			    CALCULATE ( MAX ( Warehouses[Capacity Units] ) )
			)
		formatString: #,0
		displayFolder: Capacity
		lineageTag: 124d186a-cfd4-5abf-b27b-5d6bc382427e

	measure 'Network Utilisation' =
			DIVIDE ( [On Hand Units], [Capacity In Scope] )
		formatString: 0.0%
		displayFolder: Capacity
		lineageTag: 57e36a93-5dba-5f8c-9cdf-f44c8bac303a

	measure 'Gauge Max' =
			1
		formatString: 0%
		displayFolder: Capacity
		lineageTag: 665d6c20-8668-5aa8-a471-41a3475060b9

	measure 'Gauge Warning' =
			0.9
		formatString: 0%
		displayFolder: Capacity
		lineageTag: a1f0eac9-899a-58c5-a0a3-3c48481824fa

	column 'Inventory ID'
		dataType: string
		isHidden
		lineageTag: d3f9f25a-6123-5c75-9844-1c3f2467639a
		summarizeBy: none
		sourceColumn: Inventory ID

		annotation SummarizationSetBy = Automatic

	column 'Product ID'
		dataType: string
		isHidden
		lineageTag: 36e52d1c-caa6-5e2e-85eb-bd0f3747a5b3
		summarizeBy: none
		sourceColumn: Product ID

		annotation SummarizationSetBy = Automatic

	column 'Warehouse ID'
		dataType: string
		isHidden
		lineageTag: 5c8def46-bf71-51bd-9051-79d32760ffa4
		summarizeBy: none
		sourceColumn: Warehouse ID

		annotation SummarizationSetBy = Automatic

	column Batch
		dataType: string
		lineageTag: af0a2a20-e392-5b77-921e-68e1dd99c953
		summarizeBy: none
		sourceColumn: Batch

		annotation SummarizationSetBy = Automatic

	column Quantity
		dataType: int64
		formatString: #,0
		lineageTag: a4d0a69b-39c4-5c8a-a642-4a31536da190
		summarizeBy: sum
		sourceColumn: Quantity

		annotation SummarizationSetBy = Automatic

	column 'Expiry Date'
		dataType: dateTime
		formatString: dd mmm yyyy
		lineageTag: ad9e3002-5d14-51b3-b8ca-07860c629694
		summarizeBy: none
		sourceColumn: Expiry Date

		annotation SummarizationSetBy = Automatic

	column 'Last Updated'
		dataType: dateTime
		formatString: dd mmm yyyy
		isHidden
		lineageTag: e5e311b8-bb82-5172-9571-995d2a34969f
		summarizeBy: none
		sourceColumn: Last Updated

		annotation SummarizationSetBy = Automatic

	column 'Days To Expiry'
		dataType: int64
		formatString: 0
		lineageTag: c39b46d1-0b6a-592a-b35e-4031169e8e1a
		summarizeBy: none
		sourceColumn: Days To Expiry

		annotation SummarizationSetBy = Automatic

	column 'Expiry Risk'
		dataType: string
		lineageTag: 85eddd13-3aa8-5b0c-a58d-993521728880
		summarizeBy: none
		sourceColumn: Expiry Risk
		sortByColumn: 'Risk Order'

		annotation SummarizationSetBy = Automatic

	column 'Risk Order'
		dataType: int64
		isHidden
		lineageTag: c8846d64-374d-52e0-9963-b6c9594e8731
		summarizeBy: none
		sourceColumn: Risk Order

		annotation SummarizationSetBy = Automatic

	column 'Usable Quantity'
		dataType: int64
		formatString: #,0
		lineageTag: 4e63e419-1e74-56e8-96f6-94bbf63f5fe7
		summarizeBy: sum
		sourceColumn: Usable Quantity

		annotation SummarizationSetBy = Automatic

	column 'Stock Value' = Inventory[Quantity] * RELATED ( Products[Unit Cost] )
		dataType: double
		formatString: $#,0.00
		lineageTag: c24d5b53-f86c-5352-9ba8-cb9234d45113
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition Inventory = m
		mode: import
		source =
				let
				    Source = Csv.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Renamed = Table.RenameColumns(Promoted, {{"inventory_id", "Inventory ID"}, {"product_id", "Product ID"}, {"warehouse_id", "Warehouse ID"}, {"batch_number", "Batch"}, {"quantity", "Quantity"}, {"expiry_date", "Expiry Date"}, {"last_updated", "Last Updated"}}),
				    Typed = Table.TransformColumnTypes(Renamed, {{"Inventory ID", type text}, {"Product ID", type text}, {"Warehouse ID", type text}, {"Batch", type text}, {"Quantity", Int64.Type}, {"Expiry Date", type date}, {"Last Updated", type date}}, "en-US"),
				    DaysToExpiry = Table.AddColumn(Typed, "Days To Expiry", each Duration.Days([Expiry Date] - [Last Updated]), Int64.Type),
				    Risk = Table.AddColumn(DaysToExpiry, "Expiry Risk", each if [Days To Expiry] < 0 then "Expired" else if [Days To Expiry] <= 30 then "Within 30 days" else if [Days To Expiry] <= 90 then "31-90 days" else "Over 90 days", type text),
				    RiskOrder = Table.AddColumn(Risk, "Risk Order", each if [Days To Expiry] < 0 then 1 else if [Days To Expiry] <= 30 then 2 else if [Days To Expiry] <= 90 then 3 else 4, Int64.Type),
				    Usable = Table.AddColumn(RiskOrder, "Usable Quantity", each if [Days To Expiry] < 0 then 0 else [Quantity], Int64.Type)
				in
				    Usable

	annotation PBI_ResultType = Table

