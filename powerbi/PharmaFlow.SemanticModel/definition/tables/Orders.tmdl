table Orders
	lineageTag: b6198598-9e4c-55d8-b3f0-5b1a8566b9c7

	measure 'Units Moved' =
			SUM ( Orders[Quantity] )
		formatString: #,0
		lineageTag: 0e2d9bf7-8cdc-5ae3-ad9c-a620e98b26ab

	measure 'Period Days' =
			DATEDIFF ( MIN ( 'Date'[Date] ), MAX ( 'Date'[Date] ), DAY ) + 1
		formatString: 0
		lineageTag: 23dd1903-231c-50a7-a1fb-6ba4120050c0

	measure 'Inventory Turnover' =
			-- Annualised: outbound units / units on hand, scaled to a 365-day year
			DIVIDE ( [Units Moved] + 0, MAX ( [On Hand Units], 1 ) ) * DIVIDE ( 365, [Period Days] )
		formatString: 0.00
		lineageTag: c40fd4bd-e2ff-5ce0-b337-585a497afd6a

	measure 'Forecast Accuracy' =
			-- 1 minus WAPE (weighted absolute percentage error)
			VAR _actual = SUM ( Orders[Quantity] )
			VAR _error = SUM ( Orders[Abs Forecast Error] )
			RETURN MAX ( 0, 1 - DIVIDE ( _error, MAX ( _actual, 1 ) ) )
		formatString: 0.0%
		lineageTag: 259a5482-b4ab-5b71-b57f-8cdf3e4e824f

	column 'Order ID'
		dataType: string
		isHidden
		lineageTag: 55b6581e-4179-597b-8d2c-63e9dbabbf61
		summarizeBy: none
		sourceColumn: Order ID

		annotation SummarizationSetBy = Automatic

	column 'Order Date'
		dataType: dateTime
		formatString: dd mmm yyyy
		lineageTag: e5639344-4fdf-515d-93ed-99b4151a3fb6
		summarizeBy: none
		sourceColumn: Order Date

		annotation SummarizationSetBy = Automatic

	column 'Product ID'
		dataType: string
		isHidden
		lineageTag: b521f93b-84ea-5cb4-b7da-23271028f78e
		summarizeBy: none
		sourceColumn: Product ID

		annotation SummarizationSetBy = Automatic

	column 'Warehouse ID'
		dataType: string
		isHidden
		lineageTag: 6ba097d3-3d8b-5817-875b-6954e4b86790
		summarizeBy: none
		sourceColumn: Warehouse ID

		annotation SummarizationSetBy = Automatic

	column Quantity
		dataType: int64
		formatString: #,0
		lineageTag: 0fa33918-8820-5f6f-a86a-5b9717966f90
		summarizeBy: sum
		sourceColumn: Quantity

		annotation SummarizationSetBy = Automatic

	column 'Forecast Quantity'
		dataType: int64
		formatString: #,0
		lineageTag: 482a4518-6129-5637-90e5-0d45fca57029
		summarizeBy: sum
		sourceColumn: Forecast Quantity

		annotation SummarizationSetBy = Automatic

	column 'Abs Forecast Error'
		dataType: int64
		formatString: #,0
		isHidden
		lineageTag: 4162e21b-38b0-519f-af61-baf1d2a2070e
		summarizeBy: sum
		sourceColumn: Abs Forecast Error

		annotation SummarizationSetBy = Automatic

	partition Orders = m
		mode: import
		source =
				let
				    Source = Csv.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Renamed = Table.RenameColumns(Promoted, {{"order_id", "Order ID"}, {"order_date", "Order Date"}, {"product_id", "Product ID"}, {"warehouse_id", "Warehouse ID"}, {"quantity", "Quantity"}, {"forecast_quantity", "Forecast Quantity"}}),
				    Typed = Table.TransformColumnTypes(Renamed, {{"Order ID", type text}, {"Order Date", type date}, {"Product ID", type text}, {"Warehouse ID", type text}, {"Quantity", Int64.Type}, {"Forecast Quantity", Int64.Type}}, "en-US"),
				    AbsError = Table.AddColumn(Typed, "Abs Forecast Error", each Number.Abs([Forecast Quantity] - [Quantity]), Int64.Type)
				in
				    AbsError

	annotation PBI_ResultType = Table

