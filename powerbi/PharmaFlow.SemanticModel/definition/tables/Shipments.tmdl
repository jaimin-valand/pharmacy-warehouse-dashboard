table Shipments
	lineageTag: 20207e10-c66b-5c7b-9d10-f77486fc29c3

	measure 'Inbound Units' =
			SUM ( Shipments[Quantity] )
		formatString: #,0
		lineageTag: 75b16ed0-0cfd-53c6-a99b-814a11883da6

	measure Receipts =
			COUNTROWS ( Shipments )
		formatString: #,0
		lineageTag: bba95884-fe33-50c6-8805-eeb91b92f847

	measure 'On-Time Delivery' =
			AVERAGE ( Shipments[On Time Flag] )
		formatString: 0.0%
		lineageTag: 538f11bb-938b-5a5d-9f81-f19131721d4e

	column 'Shipment ID'
		dataType: string
		isHidden
