		summarizeBy: sum
		sourceColumn: On Time Flag

		annotation SummarizationSetBy = Automatic

	partition Shipments = m
		mode: import
		source =
				let
				    Source = Csv.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Renamed = Table.RenameColumns(Promoted, {{"shipment_id", "Shipment ID"}, {"supplier_id", "Supplier ID"}, {"product_id", "Product ID"}, {"warehouse_id", "Warehouse ID"}, {"order_date", "Order Date"}, {"expected_delivery", "Expected Delivery"}, {"actual_delivery", "Actual Delivery"}, {"quantity", "Quantity"}, {"on_time", "On Time"}}),
				    Typed = Table.TransformColumnTypes(Renamed, {{"Shipment ID", type text}, {"Supplier ID", type text}, {"Product ID", type text}, {"Warehouse ID", type text}, {"Order Date", type date}, {"Expected Delivery", type date}, {"Actual Delivery", type date}, {"Quantity", Int64.Type}}, "en-US"),
				    Flag = Table.AddColumn(Typed, "On Time Flag", each if Text.Lower([On Time]) = "true" then 1 else 0, Int64.Type),
				    Clean = Table.RemoveColumns(Flag, {"On Time"})
				in
				    Clean

	annotation PBI_ResultType = Table

